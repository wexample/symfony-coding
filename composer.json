{
  "name": "wexample/symfony-coding",
  "description": "Code as a tool for Symfony: fields to write it in",
  "type": "library",
  "license": "MIT",
  "version": "4.0.4",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyCoding\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=29.0.0",
    "wexample/symfony-helpers": ">=13.0.0"
  },
  "scripts": {
    "post-install-cmd": [
      "php bin/console coding:check-node-install"
    ],
    "post-update-cmd": [
      "php bin/console coding:check-node-install"
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}