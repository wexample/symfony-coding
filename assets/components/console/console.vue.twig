{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyCodingBundle.common.coding::console.*') }}
{%- endblock -%}

{%- block vue_body -%}
    <div
            class="console"
            role="log"
            :aria-live="topic ? 'polite' : null"
            :aria-label="resolvedLabel"
            :style="maxHeight ? { '--console-max-height': maxHeight } : null"
    >
        <div v-if="title || copy" class="console--bar">
            <span v-if="title" class="console--title">[[ title ]]</span>
            <button
                    v-if="copy"
                    type="button"
                    class="action-icon console--copy"
                    :class="{ 'is-copied': copied }"
                    :aria-label="copyLabel"
                    :data-tooltip="copied ? copiedLabel : copyLabel"
                    @click="copyShown"
                    v-html="copyIconHtml"
            ></button>
        </div>
        <div ref="body" class="console--body">
            <div
                    v-for="(line, index) in shownLines"
                    :key="index"
                    :class="['console--line', 'console--line--' + line.kind]"
            ><span v-if="line.kind === 'command'" class="console--prompt">[[ line.prompt ]] </span><span
                    v-for="(segment, segmentIndex) in line.segments"
                    :key="segmentIndex"
                    :class="segment.classes"
            >[[ segment.text ]]</span></div>
        </div>
    </div>
{%- endblock -%}
