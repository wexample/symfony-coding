{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyCodingBundle.common.coding::editor.*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyCodingBundle/components/source-view') -}}
{%- endblock -%}

{%- block vue_body -%}
    {#- A text written and kept: the editor, and whether what is on screen is
        what is on disk — at its foot, or where the page says. -#}
    <div class="source-editor">
        <source-view
                ref="source"
                class="source-editor--source"
                :text="text"
                :language="language"
                :annotations="annotations"
                :editable="true"
                :flush="flush"
                @change="changed"
        ></source-view>
        {#- Said where the page wants it (`statusTarget`) — the layout's
            footer —, or else at the editor's own foot. -#}
        <teleport v-if="statusTarget" :to="statusTarget">
            <span
                    v-if="state !== 'idle'"
                    class="source-editor--state"
                    :class="'source-editor--state--' + state"
                    role="status"
                    aria-live="polite"
            >[[ stateLabel ]]</span>
        </teleport>
        <div v-else class="source-editor--status">
            <span class="source-editor--language">[[ language ]]</span>
            <span
                    class="source-editor--state"
                    :class="'source-editor--state--' + state"
                    role="status"
                    aria-live="polite"
            >[[ stateLabel ]]</span>
        </div>
    </div>
{%- endblock -%}
