{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyCodingBundle.common.coding::editor.*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyCodingBundle/components/source-view') -}}
{%- endblock -%}

{%- block vue_body -%}
    {#- A text written and kept: the editor, and under it the line an editor
        has at its foot — what the text is, and whether what is on screen is
        what is on disk. -#}
    <div class="source-editor">
        <source-view
                ref="source"
                class="source-editor--source"
                :text="text"
                :language="language"
                :editable="true"
                :flush="flush"
                @change="changed"
        ></source-view>
        <div class="source-editor--status">
            <span class="source-editor--language">[[ language ]]</span>
            <span
                    class="source-editor--state"
                    :class="'source-editor--state--' + state"
                    role="status"
                    aria-live="polite"
            >[[ stateLabel ]]</span>
        </div>
    </div>
{%- endblock -%}
